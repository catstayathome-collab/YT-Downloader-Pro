    "error.outputPermissionDenied.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The output folder cannot be written to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先フォルダに書き込めません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法寫入輸出資料夾。"
          }
        }
      }
    },
    "error.outputPermissionDenied.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Edit options and retry, select a writable output folder, then reanalyze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定を変更して再試行」で書き込み可能な保存先を選び、再解析してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇「編輯選項並重試」，改用可寫入的輸出資料夾，再重新分析。"
          }
        }
      }
    },
    "error.diskFull.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough disk space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクの空き容量が不足しています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "磁碟空間不足。"
          }
        }
      }
    },
    "error.diskFull.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free disk space, or choose another folder with Edit options and retry, then reanalyze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量を増やすか、「設定を変更して再試行」で別の保存先を選び、再解析してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請釋出空間，或在「編輯選項並重試」改用其他資料夾，再重新分析。"
          }
        }
      }
    },
    "error.downloadFailed.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download did not complete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが完了しませんでした。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載未完成。"
          }
        }
      }
    },
    "error.downloadFailed.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry the download. Open error details if the problem continues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードを再試行してください。続く場合はエラーの詳細を開いてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重試下載；若問題持續，請開啟錯誤詳細資訊。"
          }
        }
      }
    },
    "error.postProcessingFailed.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded media could not be finished."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたメディアの仕上げに失敗しました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成下載媒體的處理。"
          }
        }
      }
    },
    "error.postProcessingFailed.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check available disk space and folder access, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量とフォルダへのアクセスを確認し、再試行してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認磁碟空間與資料夾權限，然後重試。"
          }
        }
      }
    },
    "error.persistenceRecovery.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved download history needed recovery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのダウンロード履歴を復旧する必要がありました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的下載記錄需要復原。"
          }
        }
      }
    },
    "error.persistenceRecovery.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the restored queue. Damaged data was preserved for diagnostics."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧したキューを確認してください。破損データは診断用に保存されています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查已復原的佇列；損壞資料已保留供診斷使用。"
          }
        }
      }
    },
    "error.unknown.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unexpected download error occurred."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予期しないダウンロードエラーが発生しました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生未預期的下載錯誤。"
          }
        }
      }
    },
    "error.unknown.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. Open error details if the problem continues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行してください。続く場合はエラーの詳細を開いてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再試一次；若問題持續，請開啟錯誤詳細資訊。"
          }
        }
      }
    },
