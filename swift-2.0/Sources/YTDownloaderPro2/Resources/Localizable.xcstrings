    "download.action.fileUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, unavailable because the file is missing or is not a regular file"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。ファイルが見つからないか通常のファイルではないため使用できません"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，因檔案遺失或不是一般檔案而無法使用"
