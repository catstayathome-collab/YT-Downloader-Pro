          }
        }
      }
    },
    "error.networkUnavailable.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network connection was interrupted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク接続が中断されました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路連線已中斷。"
          }
        }
      }
    },
    "error.networkUnavailable.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection, then retry the download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認してから、ダウンロードを再試行してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
