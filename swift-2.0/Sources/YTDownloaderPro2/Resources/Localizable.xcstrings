    "confirmation.cancelActive.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial files for active and waiting downloads will be removed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中および待機中のダウンロードの一時ファイルは削除されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中與等待中下載的部分檔案將被移除。"
          }
        }
      }
    },
    "confirmation.cancelActive.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel active and waiting downloads?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中および待機中のダウンロードをキャンセルしますか？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要取消進行中與等待中的下載嗎？"
          }
        }
      }
    },
    "confirmation.cancelDownload.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Download"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードをキャンセル"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消下載"
          }
        }
      }
    },
    "confirmation.cancelDownloads.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Downloads"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードをキャンセル"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消下載"
          }
        }
      }
    },
    "confirmation.cancelMerging.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelling now removes partial files created by this download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今キャンセルすると、このダウンロードが作成した一時ファイルは削除されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在取消將移除此下載建立的部分檔案。"
          }
        }
      }
    },
    "confirmation.cancelMerging.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this download?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このダウンロードをキャンセルしますか？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要取消此下載嗎？"
          }
        }
      }
    },
    "confirmation.clearHistory.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear History"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を消去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除下載紀錄"
          }
        }
      }
    },
    "confirmation.clearHistory.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded media files will remain. Completed, failed, and cancelled history records and their cached thumbnails will be removed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード済みのメディアは残ります。完了、失敗、キャンセル済みの履歴とキャッシュ済みサムネイルが削除されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已下載的媒體檔案會保留；完成、失敗與已取消的歷史記錄及其快取縮圖將被移除。"
          }
        }
      }
    },
    "confirmation.clearHistory.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear download history?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード履歴を消去しますか？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除下載紀錄嗎？"
          }
        }
      }
    },
    "confirmation.removeRecord.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Record"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を削除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除記錄"
          }
        }
      }
    },
    "confirmation.removeRecord.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The media file will remain. Only this history record and its cached thumbnail will be removed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアファイルは残ります。この履歴とキャッシュ済みサムネイルだけが削除されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "媒體檔案會保留，只會移除此歷史記錄與快取縮圖。"
          }
        }
      }
    },
    "confirmation.removeRecord.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this record?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この履歴を削除しますか？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除此記錄嗎？"
          }
        }
      }
    },
