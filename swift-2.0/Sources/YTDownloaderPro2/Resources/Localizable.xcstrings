          }
        }
      }
    },
    "error.authenticationRequired.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This media requires account access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメディアにはアカウントでのアクセスが必要です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個媒體需要帳號權限。"
          }
        }
      }
    },
    "error.authenticationRequired.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Edit options and retry, select browser cookies for this download, then reanalyze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定を変更して再試行」で、このダウンロードに使うブラウザCookieを選び、再解析してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇「編輯選項並重試」，為這筆下載選擇瀏覽器 Cookie，再重新分析。"
          }
        }
      }
    },
    "error.clientValidationFailed.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video service rejected this download request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画サービスがダウンロード要求を拒否しました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片服務拒絕了這次下載要求。"
          }
        }
      }
    },
    "error.clientValidationFailed.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry to refresh the media information. If it continues, try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行してメディア情報を更新してください。続く場合は時間をおいてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重試以更新媒體資訊；若仍失敗，請稍後再試。"
          }
        }
      }
    },
    "error.formatReselectionRequired.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected format is no longer available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した形式は利用できなくなりました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選格式已無法使用。"
          }
        }
      }
    },
    "error.formatReselectionRequired.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Edit options and retry, reanalyze, then select one of the refreshed formats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定を変更して再試行」で再解析し、更新された形式から選んでください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇「編輯選項並重試」，重新分析後再選擇更新的格式。"
          }
        }
      }
    },
    "error.unavailableMedia.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This media is unavailable."
